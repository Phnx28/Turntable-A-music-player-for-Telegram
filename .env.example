# Telegram API credentials — only needed if you want to override the built-in ones.
# Most users can leave these commented out.
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=replace-with-your-api-hash

# Optional: encryption key is auto-generated and persisted on first run.
# APP_ENCRYPTION_KEY=
MUSICBRAINZ_CONTACT=you@example.com
DATA_DIR=/data
# Set only for local HTTP development. Keep unset behind HTTPS.
# DEV_INSECURE_COOKIE=1
