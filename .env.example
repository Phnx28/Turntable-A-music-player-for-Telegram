# Telegram API credentials. Register your own at https://my.telegram.org to avoid sharing
# the built-in registration with every other install -- see README for why that matters.
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=replace-with-your-api-hash

# Optional: encryption key is auto-generated and persisted to DATA_DIR on first run.
# Setting it here instead keeps the key out of the directory holding the data it decrypts.
# APP_ENCRYPTION_KEY=

# Required for MusicBrainz metadata lookups: they reject requests with no contact.
MUSICBRAINZ_CONTACT=you@example.com

# Where the library, media cache and session live. Back this up: likes, manual lyrics and
# metadata overrides exist nowhere else. Defaults to ./data, which is right for a local
# run; the Docker image mounts a volume at /data instead.
# DATA_DIR=./data
